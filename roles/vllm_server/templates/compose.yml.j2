---
services:
{% for instance in vllm_server_instances %}
  {{ instance.name }}:
    image: "{{ vllm_server_image }}"
    container_name: "{{ instance.name }}"
    restart: unless-stopped
    ports:
      - "{{ llm_runtime_bind_address }}:{{ instance.port }}:8080"
    devices:
      - "/dev/dri:/dev/dri"
    ipc: host
    privileged: true
    environment:
      ONEAPI_DEVICE_SELECTOR: "{{ instance.device_selector }}"
      VLLM_XPU_ENABLE_XPU_GRAPH: "{{ 1 if vllm_server_enable_xpu_graph | bool else 0 }}"
    volumes:
      - "{{ vllm_server_api_key_path }}:/run/secrets/llm_api_key:ro"
      - "{{ vllm_server_hf_cache_dir }}:/root/.cache/huggingface"
      - "/dev/dri/by-path:/dev/dri/by-path:ro"
    entrypoint:
      - /bin/bash
      - -lc
    command:
      - >-
        export VLLM_API_KEY="$$(cat /run/secrets/llm_api_key)";
        exec vllm serve "{{ vllm_server_model }}"
        --revision "{{ vllm_server_model_revision }}"
        --tokenizer "{{ vllm_server_tokenizer }}"
        --tokenizer-revision "{{ vllm_server_tokenizer_revision }}"
        --served-model-name "{{ vllm_server_served_model_name }}"
        --language-model-only
        --host 0.0.0.0 --port 8080
        --dtype float16 --quantization "{{ vllm_server_quantization }}"
        --max-model-len "{{ vllm_server_context_size }}"
        --max-num-seqs "{{ vllm_server_max_num_seqs }}"
        --gpu-memory-utilization "{{ vllm_server_gpu_memory_utilization }}"
{% if instance.tensor_parallel_size | int > 1 %}
        --distributed-executor-backend mp
        --tensor-parallel-size "{{ instance.tensor_parallel_size }}"
{% endif %}
{% if vllm_server_enable_auto_tool_choice | bool %}
        --enable-auto-tool-choice
        --tool-call-parser "{{ vllm_server_tool_call_parser }}"
{% endif %}
        --generation-config vllm
{% endfor %}

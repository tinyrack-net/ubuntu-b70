+@strict
+class Gemma4UnifiedAssistantConfig(PreTrainedConfig):
+    """Configuration for the encoder-free Gemma 4 MTP assistant."""
+
+    model_type = "gemma4_unified_assistant"
+    sub_configs = {"text_config": Gemma4UnifiedTextConfig}
+
+    text_config: Gemma4UnifiedTextConfig | dict[str, Any] | None = None
+    backbone_hidden_size: int = 3840
+    tie_word_embeddings: bool = True
+    use_ordered_embeddings: bool = False
+    num_centroids: int = 2048
+    centroid_intermediate_top_k: int = 32
+    boi_token_id: int | None = 255_999
+    eoi_token_id: int | None = 258_882
+    image_token_id: int | None = 258_880
+    boa_token_id: int | None = 256_000
+    eoa_token_index: int | None = 258_883
+    audio_token_id: int | None = 258_881
+
+    def __post_init__(self, **kwargs):
+        if self.text_config is None:
+            self.text_config = Gemma4UnifiedTextConfig()
+        elif isinstance(self.text_config, dict):
+            self.text_config = Gemma4UnifiedTextConfig(**self.text_config)
+        super().__post_init__(**kwargs)
+
+
+__all__ = ["Gemma4UnifiedAssistantConfig", "Gemma4UnifiedAudioConfig", "Gemma4UnifiedConfig", "Gemma4UnifiedTextConfig", "Gemma4UnifiedVisionConfig"]
